{
  "name": "uk-11-plus-practice",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "tsx scripts/generate-questions.ts",
    "split": "tsx scripts/split-bank.ts",
    "validate": "tsx scripts/validate-questions.ts",
    "review": "tsx scripts/review-sheet.ts",
    "review:accept": "tsx scripts/review-accept.ts",
    "test": "npm run generate && npm run split && tsx scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate && npm run split && npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
